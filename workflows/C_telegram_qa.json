{
  "name": "CI Agent · C - Telegram Q&A",
  "nodes": [
    {
      "parameters": {
        "content": "## Workflow C — Telegram Q&A (human in the loop)\nAsk the bot questions like *\"What did Asana do on pricing this quarter?\"*. The agent answers only from the logged data, with sources. Only your own chat ID is allowed.\n\n⚠️ Telegram triggers need a public HTTPS URL — run n8n with a tunnel (ngrok / cloudflared) and set `WEBHOOK_URL`.",
        "width": 620,
        "height": 240,
        "color": 4
      },
      "id": "a8f88634-48a3-4b4d-9fa4-e902f160d71d",
      "name": "Note aed6bf",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        -420
      ]
    },
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "353471ef-bb4a-4f13-af58-caa076afa144",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "aabd4ac8-84fc-4289-9479-905f365dc8bb",
              "name": "telegram_chat_id",
              "value": "PASTE_YOUR_TELEGRAM_CHAT_ID",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "bf99445b-b88e-4485-be54-f38a3f2c0640",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "ac0bb968-8b0e-4c83-a973-5ea933f42e2d",
              "leftValue": "={{ String($('Telegram Trigger').item.json.message.chat.id) }}",
              "rightValue": "={{ String($json.telegram_chat_id) }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "c7403293-47cb-4df0-81b6-3fd16a7ad570",
      "name": "Authorised Chat?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Today is {{ $now.toFormat('dd LLL yyyy') }}.\nQuestion: {{ $('Telegram Trigger').item.json.message.text }}",
        "options": {
          "systemMessage": "You are the competitive-intelligence assistant for a product team in the product-management / work-management software market (Notion, Atlassian Jira & Confluence, Asana, monday.com, Linear and similar tools). You answer questions sent on Telegram, e.g. \"What did Asana do on pricing this quarter?\".\n\nRules:\n- Answer ONLY from the data returned by your tools (read_intel_log, read_briefs, compare_with_last_month). Never use outside knowledge.\n- Interpret time ranges using today's date. \"This quarter\" = the current calendar quarter.\n- Filter by competitor and category where relevant (categories: pricing, product_launch, hiring, partnership, campaign, other).\n- Every claim must cite its source as: title — link (date).\n- If the logged data does not contain the answer, reply: \"I don't have logged data on that yet.\" and suggest what to track.\n- Keep answers under 200 words, plain text (no Markdown tables).",
          "maxIterations": 8
        }
      },
      "id": "2c28de5a-97fb-480f-831c-06dac17ef794",
      "name": "Q&A Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        680,
        -100
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-flash-lite-latest",
        "options": {
          "temperature": 0.2
        }
      },
      "id": "f0b76826-7f8d-4d0b-ae01-e797932c9615",
      "name": "Gemini Flash-Lite",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        520,
        160
      ]
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "contextWindowLength": 8
      },
      "id": "0a69216d-f60f-4edc-b7c1-90340b999f83",
      "name": "Chat Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        660,
        160
      ]
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Reads every logged competitor-intelligence item from the Intel_Log data table. Columns: date (logged), competitor, source_type, title, link, published, category (pricing/product_launch/hiring/partnership/campaign/other), impact_score (1-10), is_relevant, summary, reasoning, model_used, alerted.",
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "Intel_Log",
          "mode": "name"
        },
        "returnAll": true
      },
      "id": "97a603ca-f3bd-4278-bcbe-718a8c578ff6",
      "name": "read_intel_log",
      "type": "n8n-nodes-base.dataTableTool",
      "typeVersion": 1.1,
      "position": [
        800,
        160
      ]
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Reads past weekly briefs. Columns: week, generated_at, status (final/rejected), brief (markdown).",
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "Briefs",
          "mode": "name"
        },
        "returnAll": true
      },
      "id": "ec25c9ae-6eaa-4b4d-a3bf-9adbd811a5ff",
      "name": "read_briefs",
      "type": "n8n-nodes-base.dataTableTool",
      "typeVersion": 1.1,
      "position": [
        940,
        160
      ]
    },
    {
      "parameters": {
        "description": "Compares the last 30 days of logged competitor activity with the previous 30 days. Returns item counts, high-impact counts, average impact score and category mix per competitor. Input: a competitor name, or 'all'.",
        "workflowId": {
          "__rl": true,
          "value": "__COMPARE_WORKFLOW_ID__",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "competitor": "={{ $fromAI('competitor', 'Competitor name exactly as logged, or all', 'string') }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "competitor",
              "displayName": "competitor",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string",
              "removed": false
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        }
      },
      "id": "8853f0fd-9dfe-46f5-a6c1-d1aaceca3d22",
      "name": "compare_with_last_month",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "typeVersion": 2.2,
      "position": [
        1080,
        160
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{ $json.output.slice(0, 4000) }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "eace0e02-07cf-46c7-b6b0-669c1b7d7675",
      "name": "Reply on Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1060,
        -100
      ]
    }
