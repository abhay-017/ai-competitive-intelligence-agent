              "value": "PASTE_YOUR_TELEGRAM_CHAT_ID",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "be0ed52f-5d6c-4825-8f49-415a951e1a89",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "536f0b88-b470-4fd5-96cd-f1fa0c06276f",
              "leftValue": "={{ String($('Telegram Trigger').item.json.message.chat.id) }}",
              "rightValue": "={{ String($json.telegram_chat_id) }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "ad0cbfc6-902d-4064-ac96-0cf471142641",
      "name": "Authorised Chat?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Today is {{ $now.toFormat('dd LLL yyyy') }}.\nQuestion: {{ $('Telegram Trigger').item.json.message.text }}",
        "options": {
          "systemMessage": "You are the competitive-intelligence assistant for a product team in the product-management / work-management software market (Notion, Atlassian Jira & Confluence, Asana, monday.com, Linear and similar tools). You answer questions sent on Telegram, e.g. \"What did Asana do on pricing this quarter?\".\n\nRules:\n- Answer ONLY from the data returned by your tools (read_intel_log, read_briefs, compare_with_last_month). Never use outside knowledge.\n- Interpret time ranges using today's date. \"This quarter\" = the current calendar quarter.\n- Filter by competitor and category where relevant (categories: pricing, product_launch, hiring, partnership, campaign, other).\n- Every claim must cite its source as: title — link (date).\n- If the logged data does not contain the answer, reply: \"I don't have logged data on that yet.\" and suggest what to track.\n- Keep answers under 200 words, plain text (no Markdown tables).",
          "maxIterations": 8
        }
      },
      "id": "8d98903c-00bf-4dbb-a2f0-54b9c596b158",
      "name": "Q&A Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        680,
        -100
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {
          "temperature": 0.2
        }
      },
      "id": "2ed3de5e-d1b5-4112-8a1f-7c4bec59a840",
      "name": "Gemini 2.5 Flash",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        520,
        160
      ]
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "contextWindowLength": 8
      },
      "id": "e8f7423c-f91d-46e6-aaf4-b7eb495f1c10",
      "name": "Chat Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        660,
        160
      ]
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Reads every logged competitor-intelligence item from the Intel_Log sheet. Columns: date (logged), competitor, source_type, title, link, published, category (pricing/product_launch/hiring/partnership/campaign/other), impact_score (1-10), is_relevant, summary, reasoning, model_used, alerted.",
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $('Config').first().json.sheet_id }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Intel_Log",
          "mode": "name"
        },
        "options": {}
      },
      "id": "5c9ee15d-9266-45a5-b56e-630bc644a51b",
      "name": "read_intel_log",
      "type": "n8n-nodes-base.googleSheetsTool",
      "typeVersion": 4.7,
      "position": [
        800,
        160
      ]
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Reads past weekly briefs. Columns: week, generated_at, status (final/rejected), brief (markdown).",
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $('Config').first().json.sheet_id }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Briefs",
          "mode": "name"
        },
        "options": {}
      },
      "id": "2583f4df-58b5-44c6-b087-3add77fed06c",
      "name": "read_briefs",
      "type": "n8n-nodes-base.googleSheetsTool",
      "typeVersion": 4.7,
      "position": [
        940,
        160
      ]
    },
    {
      "parameters": {
        "description": "Compares the last 30 days of logged competitor activity with the previous 30 days. Returns item counts, high-impact counts, average impact score and category mix per competitor. Input: a competitor name, or 'all'.",
        "workflowId": {
          "__rl": true,
          "value": "__COMPARE_WORKFLOW_ID__",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "competitor": "={{ $fromAI('competitor', 'Competitor name exactly as logged, or all', 'string') }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "competitor",
              "displayName": "competitor",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string",
              "removed": false
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        }
      },
      "id": "cd83c17a-5a14-41c9-8f70-635004bd16e7",
      "name": "compare_with_last_month",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "typeVersion": 2.2,
      "position": [
        1080,
        160
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{ $json.output.slice(0, 4000) }}",
        "additionalFields": {
