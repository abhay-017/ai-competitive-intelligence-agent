{
  "name": "CI Agent · C - Telegram Q&A",
  "nodes": [
    {
      "parameters": {
        "content": "## Workflow C — Telegram Q&A (human in the loop)\nAsk the bot questions like *\"What did Asana do on pricing this quarter?\"*. The agent answers only from the logged data, with sources. Only your own chat ID is allowed.\n\n⚠️ Telegram triggers need a public HTTPS URL — run n8n with a tunnel (ngrok / cloudflared) and set `WEBHOOK_URL`.",
        "width": 620,
        "height": 240,
        "color": 4
      },
      "id": "2209c388-509f-4b79-ac39-b801da2c1d98",
      "name": "Note d6394f",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        -420
      ]
    },
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "529d1ab1-2325-4a67-93c7-b3922408d4da",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "9d97e202-e9c4-4b20-a02e-592eb0400839",
              "name": "sheet_id",
              "value": "PASTE_YOUR_GOOGLE_SHEET_ID",
              "type": "string"
            },
            {
              "id": "f23e93b8-8d18-409c-bce4-6c6d0d9ddab4",
