        "message": "={{ $json.brief_html }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "db42bb0f-33b2-4ff4-b1ab-39a7f17bcf5b",
      "name": "Email Brief (Gmail)",
      "type": "n8n-nodes-base.gmail",
