              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b4b0fc9a-f24d-471c-a855-179b82d7ecb0",
      "name": "Prepare Brief",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        820,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('Config').first().json.telegram_chat_id }}",
        "text": "=📋 Weekly competitive brief {{ $json.week }} is ready.\n\nRecommendations are DRAFT until you approve them. Open the approval email sent to {{ $('Config').first().json.brief_email }} and click Approve or Decline.",
